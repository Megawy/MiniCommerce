# Copy to .env and adjust. Never commit .env (it is git- and docker-ignored).
DEBUG=True
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -----------------------------------------------------------------
# Django reads ONE setting: DATABASE_URL.
# Running locally (python manage.py ...): points at PostgreSQL on this machine.
DATABASE_URL=postgres://minicommerce:minicommerce@localhost:5432/minicommerce

# Docker Compose: the `db` container is created with these, and Compose builds the web
# container's DATABASE_URL from them with host `db` (overriding the line above).
# Use URL-safe characters in the password (or percent-encode them).
POSTGRES_DB=minicommerce
POSTGRES_USER=minicommerce
POSTGRES_PASSWORD=change-me-local-db-password

# --- CORS -------------------------------------------------------------------------
# Origins allowed to call the API from a browser. Dev settings default to the Angular dev
# server (http://localhost:4200); Docker Compose sets it too. Production: same origin -> empty.
# CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Cache (Redis) --------------------------------------------------------------
# Docker Compose sets REDIS_URL=redis://redis:6379/1 for the web container automatically.
# Outside Docker: leave unset for an in-process cache, or point at a local Redis:
# REDIS_URL=redis://localhost:6379/1

# --- Background jobs (Celery) ------------------------------------------------------
# Docker Compose sets CELERY_BROKER_URL=redis://redis:6379/0 for web + worker automatically.
# Outside Docker: leave unset to run tasks inline after commit (no worker needed), or use
# a local Redis and start `celery -A config worker --loglevel=INFO`:
# CELERY_BROKER_URL=redis://localhost:6379/0

# Optional (Docker): host port for the API (bound to 127.0.0.1) and Gunicorn workers.
# WEB_PORT=8000
# GUNICORN_WORKERS=3

# Optional (Docker): Angular container. FRONTEND_API_BASE_URL is compiled into the bundle and used
# by the *browser* — keep it in sync with WEB_PORT; rebuild after changing it (up --build).
# If you change FRONTEND_PORT, add the new origin to CORS_ALLOWED_ORIGINS in docker-compose.yml.
# FRONTEND_PORT=4200
# FRONTEND_API_BASE_URL=http://localhost:8000/api

# Password for `manage.py seed_demo` users (development only). Required for seeding inside
# Docker: the image runs production settings (DEBUG=False), where the built-in default is refused.
# DEMO_PASSWORD=pick-a-dev-only-password

# Production only (config.settings.prod)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
